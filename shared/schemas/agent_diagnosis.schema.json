{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent_diagnosis",
  "type": "object",
  "required": ["incident_id", "root_cause", "confidence", "agent_consensus", "candidate_fixes"],
  "properties": {
    "incident_id": {"type": "string"},
    "root_cause": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "agent_consensus": {
      "type": "object",
      "properties": {
        "monitoring_agent": {"type": "number"},
        "diagnosis_agent": {"type": "number"},
        "forecast_agent": {"type": "number"},
        "risk_agent": {"type": "number"}
      }
    },
    "candidate_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "estimated_success_rate", "reversible"],
        "properties": {
          "action": {"type": "string"},
          "params": {"type": "object"},
          "estimated_success_rate": {"type": "number"},
          "reversible": {"type": "boolean"},
          "rollback_time_seconds": {"type": "number"}
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "forecast_event",
  "type": "object",
  "required": ["forecast_id", "service_name", "predicted_incident_type", "time_to_incident_seconds", "confidence"],
  "properties": {
    "forecast_id": {"type": "string"},
    "service_name": {"type": "string"},
    "predicted_incident_type": {"type": "string"},
    "time_to_incident_seconds": {"type": "number"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "policy_decision",
  "type": "object",
  "required": ["incident_id", "decision", "reasoning", "requires_human"],
  "properties": {
    "incident_id": {"type": "string"},
    "decision": {"type": "string", "enum": ["AUTO_HEAL", "ESCALATE_TO_HUMAN"]},
    "reasoning": {"type": "string"},
    "action_approved": {"type": "string"},
    "requires_human": {"type": "boolean"}
  }
}
